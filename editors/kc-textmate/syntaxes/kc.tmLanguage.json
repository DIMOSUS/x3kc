            "1": {
              "name": "punctuation.separator.scope.kc"
            },
            "2": {
              "name": "entity.name.function.call.kc"
            }
          }
        },
        {
          "match": "\\b(this)\\s*(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
