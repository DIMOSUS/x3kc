            "1": {
              "name": "variable.language.this.kc"
            },
            "2": {
              "name": "punctuation.accessor.arrow.kc"
            },
            "3": {
              "name": "entity.name.function.member.kc"
            }
          }
        },
        {
          "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
